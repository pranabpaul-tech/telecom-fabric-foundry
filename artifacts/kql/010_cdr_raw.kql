// cdr_raw: the Jumpstart's table, extended with tower_id and region.
// Columns 1-10 are exactly what the Jumpstart emulator sends; 11-12 come from the patched emulator
// (artifacts/emulator/cdr_generator.py). create-merge adds the two new columns to an existing table
// and creates the whole table if the Eventstream has not created it yet.
.create-merge table cdr_raw (call_id:string, subscriber_id:string, call_start_time:datetime, call_end_time:datetime, duration_seconds:int, call_type:string, status:string, tower_latitude:real, tower_longitude:real, call_quality:int, tower_id:string, region:string)

// The Eventstream's Eventhouse destination (DirectIngestion) uses the JSON mapping `cdr_raw_mapping`.
// A mapping that does not list tower_id and region would ingest them as empty, so (re)define it with
// all 12 columns.
.create-or-alter table cdr_raw ingestion json mapping 'cdr_raw_mapping' '[{"column":"call_id","path":"$.call_id","datatype":"string"},{"column":"subscriber_id","path":"$.subscriber_id","datatype":"string"},{"column":"call_start_time","path":"$.call_start_time","datatype":"datetime"},{"column":"call_end_time","path":"$.call_end_time","datatype":"datetime"},{"column":"duration_seconds","path":"$.duration_seconds","datatype":"int"},{"column":"call_type","path":"$.call_type","datatype":"string"},{"column":"status","path":"$.status","datatype":"string"},{"column":"tower_latitude","path":"$.tower_latitude","datatype":"real"},{"column":"tower_longitude","path":"$.tower_longitude","datatype":"real"},{"column":"call_quality","path":"$.call_quality","datatype":"int"},{"column":"tower_id","path":"$.tower_id","datatype":"string"},{"column":"region","path":"$.region","datatype":"string"}]'
